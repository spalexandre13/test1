# ==========================================================
# CRM Alternance — variables d'environnement
# Copie ce fichier en `.env` puis remplis les valeurs.
# ==========================================================

# --- Base de donnees ---
# En LOCAL (npm run db:local) : SQLite, laisse tel quel.
#   DATABASE_URL="file:./dev.db"
# Sur VERCEL : une URL PostgreSQL (Neon, Supabase, Vercel Postgres...).
#   DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DATABASE_URL="file:./dev.db"

# --- Ton identite (affichee dans le mail et le CV) ---
SENDER_NAME="Alexandre"
SENDER_EMAIL="ton.adresse@gmail.com"
PORTFOLIO_URL="https://spalexandre13.github.io/Portfolio/"

# --- Gmail SMTP (Nodemailer) ---
# IMPORTANT : utilise un MOT DE PASSE D'APPLICATION (16 caracteres),
# pas ton mot de passe Gmail habituel. La validation en 2 etapes doit
# etre activee sur le compte.
# https://myaccount.google.com/apppasswords
GMAIL_USER="ton.adresse@gmail.com"
GMAIL_PASS="xxxx xxxx xxxx xxxx"

# --- Moteur IA ---
# "groq"   : API en ligne gratuite -> https://console.groq.com/keys
# "ollama" : serveur local          -> https://ollama.com
AI_PROVIDER="groq"

GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# --- Sourcing ---
# Cle optionnelle pour l'API La Bonne Alternance (augmente les quotas).
LBA_API_KEY=""

# --- Protection de l'acces ---
# OBLIGATOIRE des que l'application est hebergee publiquement (Vercel) :
# sans ce mot de passe, n'importe qui pourrait envoyer des mails depuis ton
# compte Gmail. En local, il est optionnel.
# Identifiant : n'importe lequel. Mot de passe : celui ci-dessous.
APP_PASSWORD=""

# --- Optionnel : Chromium deja installe en local ---
# Sur Vercel, @sparticuz/chromium est utilise automatiquement.
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"
